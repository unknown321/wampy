+// Input callbacks run on the thread calling glfwPollEvents, as required by GLFW.
+static GLFWbool inputDropped[3];
+static GLFWbool inputReset;
+
+int wampyInputWasReset(void)
+{
+    GLFWbool reset = inputReset;
+    inputReset = GLFW_FALSE;
+    return reset;
+}
+
+static void resyncInput(int fd, int index)
+{
+    unsigned char keys[(KEY_MAX + 8) / 8] = {0};
+    if (ioctl(fd, EVIOCGKEY(sizeof(keys)), keys) < 0)
+        return;
+
+    inputReset = GLFW_TRUE;
+    if (index == 1)
+        handleKeyEvent(KEY_H, !!(keys[KEY_H / 8] & (1 << (KEY_H % 8))));
+
+    // Discard any held media key or touch after an evdev queue overrun.
+    const int media[] = {KEY_ENTER, KEY_LEFT, KEY_RIGHT, KEY_VOLUMEUP, KEY_VOLUMEDOWN};
+    if (index < 2)
+    {
+        for (size_t i = 0; i < sizeof(media) / sizeof(media[0]); i++)
+            handleKeyEvent(media[i], GLFW_RELEASE);
+    }
+    else
+        _glfwInputMouseClick(_glfw.windowListHead, GLFW_MOUSE_BUTTON_1, GLFW_RELEASE, 0);
+}
