 void _glfwPollEventsNull(void)
 {
+    int* inputs[] = {&_glfw.keyboard.fdPower, &_glfw.keyboard.fd, &_glfw.touchscreen.fd};
+    static GLFWbool initialized;
+    if (!initialized)
+    {
+        resyncInput(_glfw.keyboard.fd, 1);
+        initialized = GLFW_TRUE;
+    }
+
+    for (size_t i = 0; i < sizeof(inputs) / sizeof(inputs[0]); i++)
+    {
+        if (*inputs[i] < 0)
+            continue;
+
+        // Read one batch per device so a busy touchscreen cannot starve rendering.
+        struct input_event events[32];
+        ssize_t count = read(*inputs[i], events, sizeof(events));
+        if (count < 0 && (errno == EAGAIN || errno == EINTR))
+            continue;
+        if (count <= 0 || count % sizeof(events[0]))
+        {
+            close(*inputs[i]);
+            *inputs[i] = -1;
+            _glfwInputError(GLFW_PLATFORM_ERROR, "evdev: input device disconnected or short read");
+            continue;
+        }
+
+        for (size_t j = 0; j < (size_t) count / sizeof(events[0]); j++)
+        {
+            struct input_event* event = &events[j];
+            if (event->type == EV_SYN && event->code == SYN_DROPPED)
+                inputDropped[i] = GLFW_TRUE;
+            else if (inputDropped[i])
+            {
+                if (event->type == EV_SYN && event->code == SYN_REPORT)
+                {
+                    inputDropped[i] = GLFW_FALSE;
+                    resyncInput(*inputs[i], i);
+                }
+            }
+            else if (i == 2)
+                handleTSEvent(event->code, event->value, event->type);
+            else if (event->type == EV_KEY)
+                handleKeyEvent(event->code, event->value);
+        }
+    }
 }
 
 void _glfwWaitEventsNull(void)
 {
+    struct pollfd inputs[] = {{_glfw.keyboard.fdPower, POLLIN, 0},
+                             {_glfw.keyboard.fd, POLLIN, 0},
+                             {_glfw.touchscreen.fd, POLLIN, 0}};
+    poll(inputs, 3, -1);
+    _glfwPollEventsNull();
 }
 
 void _glfwWaitEventsTimeoutNull(double timeout)
 {
+    struct pollfd inputs[] = {{_glfw.keyboard.fdPower, POLLIN, 0},
+                             {_glfw.keyboard.fd, POLLIN, 0},
+                             {_glfw.touchscreen.fd, POLLIN, 0}};
+    poll(inputs, 3, (int) (timeout * 1000));
+    _glfwPollEventsNull();
 }
 
